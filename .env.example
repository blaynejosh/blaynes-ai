# Copy to .env and fill in. .env is gitignored — never commit a real key.

# --- Claude on Google Cloud Vertex AI ----------------------------------------
# Read by server/index.js (AnthropicVertex client). No API key — auth is
# Application Default Credentials, same as the GCS buckets below: run
# `gcloud auth application-default login` locally, or rely on the runtime
# service account when deployed (it needs roles/aiplatform.user). The Claude
# models BLAYNE_MODEL requests also need to be enabled for this project in
# Vertex AI -> Model Garden.
ANTHROPIC_VERTEX_PROJECT_ID=your-gcp-project-id
# CLOUD_ML_REGION=global

# --- Supabase -----------------------------------------------------------
# Project Settings -> API in the Supabase dashboard.
#
# Google / Apple client IDs and secrets do NOT go here — they're configured
# directly in the Supabase dashboard under Authentication -> Providers, since
# Supabase does the OAuth token exchange itself and your code never sees them.

# Safe to expose: VITE_ vars are compiled into the browser bundle on purpose.
# The anon key is designed to be public; Row Level Security (see
# supabase/schema.sql) is what protects the data, not the secrecy of this key.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=

# NEVER give this a VITE_ prefix — it bypasses Row Level Security entirely.
# Server-side only: verifies tokens and enforces the daily message quota.
SUPABASE_SERVICE_ROLE_KEY=

# --- Skills -------------------------------------------------------------
# Blayne's skill playbooks are Markdown files in a GCS bucket, read at request
# time by server/skillStorage.js and uploaded from the local blayne_skills/
# directory by `npm run skills:upload`.
#
# Auth is Application Default Credentials, not an env var here — run
# `gcloud auth application-default login` locally, or rely on the runtime
# service account when deployed (Cloud Run/GCE already have this).
# BLAYNE_SKILLS_BUCKET=blayne-skills-bbip

# --- Brand document uploads -----------------------------------------------
# Documents a tester attaches from the chat surface (server/uploadStorage.js)
# live in their own GCS bucket, read back and sent to Claude as inline
# content blocks on each chat turn (no Files API on Vertex AI — see README).
# Same Application Default Credentials as the skills bucket above; the
# runtime service account additionally needs write/delete access here
# (roles/storage.objectAdmin), not just read.
# BLAYNE_UPLOADS_BUCKET=blayne-user-uploads

# --- Optional overrides ------------------------------------------------------
# BLAYNE_MODEL=claude-opus-5
# BLAYNE_DAILY_LIMIT=25
# PORT=8787
