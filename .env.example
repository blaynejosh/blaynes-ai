# Copy to .env and fill in. .env is gitignored — never commit a real key.

# --- Claude on Google Cloud Vertex AI ----------------------------------------
# Read by server/index.js (AnthropicVertex client). No API key — auth is
# Application Default Credentials, same as the GCS buckets below: run
# `gcloud auth application-default login` locally, or rely on the runtime
# service account when deployed (it needs roles/aiplatform.user). The Claude
# models BLAYNE_MODEL requests also need to be enabled for this project in
# Vertex AI -> Model Garden.
ANTHROPIC_VERTEX_PROJECT_ID=your-gcp-project-id
# CLOUD_ML_REGION=global

# TEMPORARY escape hatch: if set, server/index.js calls Claude via the direct
# Anthropic API instead of Vertex (same model IDs, same request/response
# shape) — for use only while Vertex AI quota on this project is too low for
# full app testing. Unset this once quota is raised; Vertex should be the
# only path in normal operation. Never commit a real key — use Secret
# Manager (--set-secrets) when deployed, not a plain env var.
# ANTHROPIC_API_KEY=

# --- Supabase -----------------------------------------------------------
# Project Settings -> API in the Supabase dashboard.
#
# Google / Apple client IDs and secrets do NOT go here — they're configured
# directly in the Supabase dashboard under Authentication -> Providers, since
# Supabase does the OAuth token exchange itself and your code never sees them.

# Safe to expose: VITE_ vars are compiled into the browser bundle on purpose.
# The anon key is designed to be public; Row Level Security (see
# supabase/schema.sql) is what protects the data, not the secrecy of this key.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=

# NEVER give this a VITE_ prefix — it bypasses Row Level Security entirely.
# Server-side only: verifies tokens and enforces the daily message quota.
SUPABASE_SERVICE_ROLE_KEY=

# --- Skills -------------------------------------------------------------
# Blayne's skill playbooks are Markdown files in a GCS bucket, read at request
# time by server/skillStorage.js and uploaded from the local blayne_skills/
# directory by `npm run skills:upload`.
#
# Auth is Application Default Credentials, not an env var here — run
# `gcloud auth application-default login` locally, or rely on the runtime
# service account when deployed (Cloud Run/GCE already have this).
# BLAYNE_SKILLS_BUCKET=blayne-skills-bbip

# --- Brand document uploads -----------------------------------------------
# Documents a tester attaches from the chat surface (server/uploadStorage.js)
# live in their own GCS bucket, read back and sent to Claude as inline
# content blocks on each chat turn (no Files API on Vertex AI — see README).
# Same Application Default Credentials as the skills bucket above; the
# runtime service account additionally needs write/delete access here
# (roles/storage.objectAdmin), not just read.
# BLAYNE_UPLOADS_BUCKET=blayne-user-uploads

# --- Service catalogue (Blayne's Consulting service-routing layer) ---------
# The reviewed catalogue (catalogue/blaynes-services.json) is uploaded to the
# same GCS bucket as the skill set, under catalogue/ — see
# server/catalogue/loader.js and `npm run catalogue:upload`. Server refuses
# to start if this can't be loaded and validated; there is no soft fallback.
#
# Embeddings (Layer B's semantic matching) come from Vertex AI's own
# text-embedding model, a separate surface from Claude — see
# server/catalogue/embeddings.js. Needs its own region: text-embedding-005
# isn't served on the `global` endpoint CLOUD_ML_REGION uses for Claude.
# CATALOGUE_EMBEDDING_REGION=us-central1
# CATALOGUE_EMBEDDING_MODEL=text-embedding-005

# Base URL the CTA-click redirect (/api/cta/:serviceId) builds links from —
# see server/catalogue/search.js. Not secret.
# PUBLIC_ORIGIN=https://blaynes.ai

# --- Catalogue freshness job (Phase 5, scripts/check-catalogue-freshness.mjs) ---
# Optional: without these, drift is written to a local report file instead of
# opening a GitHub review issue. Needs `issues: write` on this repo. Keep this
# in Secret Manager at runtime, not a plain --set-env-vars value.
# GITHUB_TOKEN=
# GITHUB_REPOSITORY=owner/repo

# --- Brand Kit / Document Engine (server/brandKit/) -------------------------
# The tenant asset store — logos, fonts, icon sets, guidelines, sample
# documents — lives in its own GCS bucket, separate from BLAYNE_UPLOADS_BUCKET
# above (see the comment atop server/brandKit/storage.js for why). Same
# Application Default Credentials; the runtime service account needs
# roles/storage.objectAdmin here too.
# BLAYNE_BRAND_KIT_BUCKET=blayne-document-engine

# Virus scanning (server/brandKit/virusScan.js) is a hard gate, not a
# warning: an upload is refused, not merely unscanned, if this isn't
# configured. Points at a clamd daemon over TCP — this process does not
# bundle ClamAV itself, clamd runs as a separate service:
#   - Locally: `docker compose up -d clamd` (see docker-compose.yml), then
#     CLAMD_HOST=localhost.
#   - CI: a GitHub Actions service container — see .github/workflows/ci.yml.
#   - Production: not yet stood up. Needs a real clamd reachable from
#     wherever this server runs (a Cloud Run sidecar, or a small separate
#     service) before Brand Kit uploads work in a deployed environment.
# CLAMD_HOST=localhost
# CLAMD_PORT=3310

# Dev-only bypass for the virus-scan gate above, when CLAMD_HOST isn't
# configured locally. Never set this in production — see the loud warning
# virusScan.js logs every time it's used.
# BRAND_KIT_SKIP_VIRUS_SCAN=true

# Caps how many pages of an uploaded PDF guideline get rendered to page
# images during ingestion — ingestion runs synchronously inside the upload
# request in Phase 1 (see server/brandKit/extractors/document.js), so this
# bounds how long that request can take.
# BRAND_KIT_MAX_PDF_PAGES=60

# --- Optional overrides ------------------------------------------------------
# BLAYNE_MODEL=claude-opus-5
# BLAYNE_DAILY_LIMIT=25
# PORT=8787
