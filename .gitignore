# dependencies
node_modules

# build output
dist
.vite

# secrets — never commit a real key.
# Catches .env, .env.local, .env.production, etc. The negation keeps the
# committed template visible; do not remove it.
.env
.env.*
!.env.example

# other credential shapes
*.pem
*.key
secrets.json
.anthropic


# local tooling state (contains machine-specific absolute paths)
.claude/settings.local.json

# skill content — data, not code; lives in GCS (see server/skillStorage.js)
blayne_skills/

# catalogue embeddings — regenerated from catalogue/blaynes-services.json via
# `npm run catalogue:embeddings`, not hand-edited; unlike the catalogue JSON
# itself, this isn't a reviewed change. See server/catalogue/embeddings.js.
catalogue/blaynes-services.embeddings.json

# freshness check output (scripts/check-catalogue-freshness.mjs)
catalogue-freshness-report.json

# logs / OS noise
*.log
npm-debug.log*
.DS_Store
Thumbs.db
