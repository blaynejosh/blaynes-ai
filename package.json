{
  "name": "blayne-web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "server": "node --env-file-if-exists=.env server/index.js",
    "dev:all": "concurrently -n web,api -c cyan,magenta \"npm:dev\" \"npm:server\"",
    "build": "vite build && node scripts/check-no-catalogue-leak.mjs",
    "preview": "vite preview",
    "start": "node --env-file-if-exists=.env server/index.js",
    "extract:hero": "node scripts/extract-hero-svg.mjs",
    "extract:hero:audit": "node scripts/extract-hero-svg.mjs --audit",
    "skills:upload": "node --env-file-if-exists=.env scripts/upload-skills.mjs",
    "skills:list": "node --env-file-if-exists=.env scripts/upload-skills.mjs --list",
    "catalogue:embeddings": "node --env-file-if-exists=.env scripts/build-catalogue-embeddings.mjs",
    "catalogue:upload": "node --env-file-if-exists=.env scripts/upload-catalogue.mjs",
    "catalogue:check-freshness": "node --env-file-if-exists=.env scripts/check-catalogue-freshness.mjs",
    "render:preview": "node scripts/render-preview.mjs",
    "test": "node --test"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.123.0",
    "@anthropic-ai/vertex-sdk": "^0.19.5",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/montserrat": "^5.3.0",
    "@google-cloud/storage": "^7.14.0",
    "@napi-rs/canvas": "^1.0.8",
    "@react-three/drei": "^10.0.0",
    "@react-three/fiber": "^9.0.0",
    "@react-three/postprocessing": "^3.0.0",
    "@supabase/supabase-js": "^2.112.3",
    "adm-zip": "^0.6.0",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "clamscan": "^2.4.0",
    "docx": "^9.7.1",
    "express": "^5.2.1",
    "fast-xml-parser": "^5.11.1",
    "fonteditor-core": "^2.6.3",
    "fontkit": "^2.0.4",
    "google-auth-library": "^9.14.0",
    "helmet": "^8.3.0",
    "mammoth": "^1.12.2",
    "multer": "^2.2.0",
    "pdf-parse": "^2.4.5",
    "playwright": "^1.63.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.18.2",
    "sharp": "^0.35.4",
    "three": "^0.185.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@vitejs/plugin-react": "^5.0.0",
    "concurrently": "^10.0.4",
    "tailwindcss": "^4.3.3",
    "vite": "^7.0.0"
  }
}
