{
  "name": "blayne-web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "server": "node --env-file-if-exists=.env server/index.js",
    "dev:all": "concurrently -n web,api -c cyan,magenta \"npm:dev\" \"npm:server\"",
    "build": "vite build",
    "preview": "vite preview",
    "start": "node --env-file-if-exists=.env server/index.js",
    "extract:hero": "node scripts/extract-hero-svg.mjs",
    "extract:hero:audit": "node scripts/extract-hero-svg.mjs --audit",
    "skills:upload": "node --env-file-if-exists=.env scripts/upload-skills.mjs",
    "skills:list": "node --env-file-if-exists=.env scripts/upload-skills.mjs --list"
  },
  "dependencies": {
    "@anthropic-ai/vertex-sdk": "^0.19.5",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/montserrat": "^5.3.0",
    "@google-cloud/storage": "^7.14.0",
    "@react-three/drei": "^10.0.0",
    "@react-three/fiber": "^9.0.0",
    "@react-three/postprocessing": "^3.0.0",
    "@supabase/supabase-js": "^2.112.3",
    "express": "^5.2.1",
    "helmet": "^8.3.0",
    "multer": "^2.2.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.18.2",
    "three": "^0.185.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@vitejs/plugin-react": "^5.0.0",
    "concurrently": "^10.0.4",
    "tailwindcss": "^4.3.3",
    "vite": "^7.0.0"
  }
